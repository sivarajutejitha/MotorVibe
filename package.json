{
  "name": "motorvibe-project",
  "version": "1.0.0",
  "description": "MotorVibe: Industrial Motor Vibration & Health Dashboard (Industry 4.0 Capstone)",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "db:init": "npm --prefix backend run db:init",
    "test:backend": "npm --prefix backend test",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,green\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
