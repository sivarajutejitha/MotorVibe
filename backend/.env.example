# ===================================================
# MotorVibe Backend Environment Variables
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/motorvibe_db

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# MQTT Broker Configuration (Industry 4.0 IIoT Sensor Stream)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=motorvibe_backend_service
MQTT_TOPIC=motorvibe/+/telemetry

# Frontend Client Origin for CORS & Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# Sensor Simulator Settings (Automatic Demo Mode)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=1000
