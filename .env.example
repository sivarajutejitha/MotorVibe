# ====================================================================
# MotorVibe Project Environment Configuration Template
# Copy this file to backend/.env and replace credentials as needed.
# ====================================================================

# Backend Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (CO-6 Relational Database)
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/motorvibe_db

# Security & JWT Token Signing
JWT_SECRET=motorvibe_industrial_secret_key_2026_super_secure
JWT_EXPIRES_IN=24h

# MQTT Broker Settings (CO-5 Real-time Streaming & IIoT)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=motorvibe_backend_service
MQTT_TOPIC=motorvibe/+/telemetry

# Frontend Client Origin for CORS and Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# Background Sensor Simulator (Demo Mode)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=1000
